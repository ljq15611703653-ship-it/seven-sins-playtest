{
  "name": "sin-squad-core",
  "version": "0.3.0",
  "private": true,
  "description": "七罪暗队 v0.3 规则核心：战斗、下注、牌桌与模拟器（无画面）",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "sim": "tsx src/sim/cli.ts",
    "build:web": "node scripts/build-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
